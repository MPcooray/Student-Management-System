## .gitignore for Student Management System

# macOS
.DS_Store

# Visual Studio / .NET
**/bin/
**/obj/
*.user
*.userosscache
*.suo
*.sln.docstates
.vs/

# Rider / IntelliJ
/.idea/

# VS Code
.vscode/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node
node_modules/
frontend/node_modules/

# Vite / build output
dist/
frontend/dist/

# Environment files
.env
.env.*

# Database files
*.db
*.sqlite

# npm
package-lock.json

# Certificates
*.pfx

# OS generated files
Thumbs.db
